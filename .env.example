# Leashh — copy to .env.local and fill in. .env.local is gitignored, never commit it.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> service_role. SERVER ONLY.
# This key bypasses row level security. It must never appear in a client
# component, in NEXT_PUBLIC_ anything, or in a response body. Every write goes
# through a route handler that holds it server side.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Transactional email — the six digit code and the confirmation email
# ---------------------------------------------------------------------------
# resend.com -> API Keys. Sending domain must be leashh.com, verified with the
# DNS records Resend gives you. Those go in Squarespace, which we already have.
RESEND_API_KEY=
MAIL_FROM="Leashh <noreply@leashh.com>"

# ---------------------------------------------------------------------------
# Bot protection
# ---------------------------------------------------------------------------
# Cloudflare dashboard -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Admin CSV export
# ---------------------------------------------------------------------------
# One shared password for the export route. This is a proof of concept, not a
# user system. Generate with: openssl rand -base64 24
ADMIN_EXPORT_PASSWORD=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used to build links in the confirmation email. The Vercel preview URL for
# now, https://leashh.com once the domain is pointed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
